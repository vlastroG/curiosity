# Ключи проекта. Скопируйте в .env рядом и подставьте свои значения.
# Файл .env в git не попадает (см. .gitignore).

# Основной провайдер -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Бесплатная модель для прогонов при разработке -- https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модель новых чатов. Для разработки -- бесплатная, для работы -- deepseek-flash.
DEFAULT_MODEL=deepseek-flash

# Модель конвейера конспектов Hacker News (src/pipeline-agent, src/mcp-pipeline).
# Не задана -- бесплатная nvidia/nemotron-3-super-120b-a12b:free.
# Допустимо: nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free,
# qwen/qwen3.8-27b:free, deepseek-flash, deepseek-v4-pro
# PIPELINE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Модель агента планирования поездок (src/trip-agent).
# Не задана -- бесплатная nvidia/nemotron-3-super-120b-a12b:free.
# Допустимо: nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free,
# qwen/qwen3.8-27b:free, deepseek-flash, deepseek-v4-pro
# TRIP_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Twain Expert (src/doc-index): ответы по книгам Марка Твена, базовый RAG и RAG с реранкером.
# RAG_MODEL -- модель ответов и переписывания вопроса.
# Допустимо: nvidia/nemotron-3-super-120b-a12b:free (по умолчанию), google/gemma-4-31b-it:free,
# qwen/qwen3.8-27b:free, deepseek-flash, deepseek-v4-pro
# RAG_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Пороги и top-K улучшенного режима; не заданы -- берутся из подбора (docindex experiment).
# TOP_K_BEFORE=20
# SIM_MIN=0.3
# REL_MIN=0.5
# TOP_K_AFTER=5
