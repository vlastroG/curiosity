# Ключи для проектов недели 1. Скопируйте в .env рядом и подставьте свои значения.
# Файл .env в git не попадает (см. .gitignore).

# Дни 1-5: прямой API DeepSeek -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# День 5: OpenRouter, нужен для слабой (бесплатной) модели -- https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
