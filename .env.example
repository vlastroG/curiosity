# Ключи проекта. Скопируйте в .env рядом и подставьте свои значения.
# Файл .env в git не попадает (см. .gitignore).

# Основной провайдер -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Бесплатная модель для прогонов при разработке -- https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модель новых чатов. Для разработки -- бесплатная, для работы -- deepseek-flash.
DEFAULT_MODEL=deepseek-flash

# Модель конвейера конспектов Hacker News (src/pipeline-agent, src/mcp-pipeline).
# Не задана -- бесплатная nvidia/nemotron-3-super-120b-a12b:free.
# Допустимо: nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free,
# qwen/qwen3.8-27b:free, deepseek-flash, deepseek-v4-pro
# PIPELINE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Модель агента планирования поездок (src/trip-agent).
# Не задана -- бесплатная nvidia/nemotron-3-super-120b-a12b:free.
# Допустимо: nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free,
# qwen/qwen3.8-27b:free, deepseek-flash, deepseek-v4-pro
# TRIP_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Twain Expert (src/doc-index): чат с экспертом по книгам Марка Твена, RAG с реранкером.
# RAG_MODEL -- модель ответов, памяти задачи и сжатия истории.
# Допустимо: nvidia/nemotron-3-super-120b-a12b:free (по умолчанию), google/gemma-4-31b-it:free,
# qwen/qwen3.8-27b:free, deepseek-flash, deepseek-v4-pro,
# local -- модель на своей видеокарте через llmcli (docker compose --profile local up -d)
# RAG_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# RAG=off -- без поиска по книгам: просто чат с моделью RAG_MODEL (один вызов на реплику,
# эмбеддинги и реранкер не загружаются). Не задан -- RAG включён.
# RAG=off
# Локальная модель doc-index (своя копия, отдельно от src/llm-cli); не задана -- qwen3.5:9b-q4_K_M.
# LLMCLI_MODEL=qwen3.5:9b-q4_K_M
# Контекст локальной модели в токенах; не задан -- максимум модели.
# LLMCLI_CTX=32768
# Пароль интерфейса doc-index (HTTP Basic, логин DOCINDEX_USER, по умолчанию twain).
# Обязателен при доступе из домашней сети (docker-compose.lan.yml); не задан -- без пароля.
# DOCINDEX_PASSWORD=
# DOCINDEX_USER=twain
# Несколько пользователей doc-index, у каждого свои чаты (вместо двух строк выше):
# DOCINDEX_USERS=twain:пароль1,huck:пароль2
# Пороги и top-K для новых чатов; не заданы -- берутся из подбора (docindex experiment).
# TOP_K_BEFORE=20
# SIM_MIN=0.3
# REL_MIN=0.5
# TOP_K_AFTER=5
# Сжимать историю нового чата, когда несжатых сообщений больше (4–50).
# COMPRESS_AFTER=12

# Поддержка пользователей (src/support-desk): ассистент по продукту, RAG + тикеты через MCP.
# SUPPORT_MODEL -- модель ответов; не задана -- deepseek-flash (нужен DEEPSEEK_API_KEY).
# SUPPORT_MODEL=deepseek-flash
# Путь к проекту с документацией на хосте; не задан -- ../../../pyRevit (рядом с репозиторием).
# SUPPORT_DOCS_PATH=C:\Users\vlast\source\repos\pyRevit
# SUPPORT_PRODUCT=pyRevit
# SUPPORT_EMBED_MODEL=bge-m3
# Ключ TypeSafe (Jev) -- защита от prompt injection и вопросов не по теме. Не задан -- защита выключена.
# https://typesafe.ai
TYPESAFE_API_KEY=
# Пороги защиты: блок при injection >= SUPPORT_GUARD_INJECTION, «не по теме» при on_topic < SUPPORT_GUARD_TOPIC.
# SUPPORT_GUARD_INJECTION=0.7
# SUPPORT_GUARD_TOPIC=0.3
